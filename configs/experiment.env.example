# Model and paths
MODEL_PATH=Qwen/Qwen3-8B
PROJECT_DIR=/data/code_repos/ywy/Project
CUDA_VISIBLE_DEVICES=0,1

# Optional Bailian Qwen rubric judge
GOV_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GOV_JUDGE_API_KEY=
GOV_JUDGE_MODEL=qwen3.7-max
GOV_JUDGE_REQUIRED=0
GOV_JUDGE_ENABLE_THINKING=0
GOV_JUDGE_CACHE=runs/judge/qwen_expression.sqlite3
GOV_JUDGE_SCHEMA_RETRIES=2
GOV_JUDGE_FAILURE_SCORE=0.0
GOV_JUDGE_ERROR_LOG=runs/judge/errors.jsonl

# Formal GRPO defaults: 16 cases x 4 rollouts = 64 trajectories per step
ROLLOUT_N=4
TRAIN_BATCH_SIZE=16
PPO_MINI_BATCH_SIZE=16
TOTAL_EPOCHS=1
TOTAL_TRAINING_STEPS=100
SAVE_FREQ=25
TEST_FREQ=25
VAL_BEFORE_TRAIN=True
EVAL_ROLLOUT_N=4
TRAIN_SEED=42
EVAL_SEED=20260719
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.95
EVAL_DO_SAMPLE=True
LOSS_AGG_MODE=token-mean
GEN_BATCH_SIZE=16
FILTER_GROUPS_ENABLE=False
FILTER_GROUPS_METRIC=score
FILTER_MAX_GEN_BATCHES=3
CLIP_RATIO=0.2
CLIP_RATIO_LOW=0.2
CLIP_RATIO_HIGH=0.2

# Optional evidence-driven reward/exploration iteration
GOV_MISSING_TOOL_PENALTY=0.45
GOV_MISSING_TOOL_HARD_GATE=1
GOV_DECISION_GATE_CEILING=0.0
GOV_PROCESS_GATE_CEILING=0.10
GOV_INVALID_SLOT_PENALTY=0.15
GOV_ILLEGAL_ACTION_PENALTY=0.25
GOV_ACTION_AFTER_DONE_PENALTY=0.10
GOV_REPEATED_TOOL_PENALTY=0.05
GOV_TOOL_ORDER_PENALTY=0.10
GOV_EARLY_ELIGIBILITY_PENALTY=0.15
GOV_HARD_FACT_WEIGHT=0.70
GOV_PROCESS_WEIGHT=0.25
GOV_EXPRESSION_WEIGHT=0.05
ENTROPY_COEFF=0.002
